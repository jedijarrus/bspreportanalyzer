# Vorlage — nach .env kopieren (die .env ist gitignored, enthält Secrets).
# docker-compose liest diese Werte automatisch.

# Veröffentlichter Host-Port (im Container lauscht uvicorn immer auf 8080)
BSP_PORT=8080

# Hinter einem HTTPS-Reverse-Proxy setzen:
# BSP_HTTPS_ONLY=true
# BSP_BASE_URL=https://bsp.example.com

# --- Azure / Entra ID SSO (optional) ---
# Alle drei setzen => SSO aktiv, Passwort-Login deaktiviert.
# Vorhandene Graph-App-Registrierung nutzbar. In Azure die Redirect-URI
#   <BSP_BASE_URL>/api/auth/azure/callback   (Plattform "Web")
# eintragen und die Enterprise-App auf "Assignment required = Yes" stellen.
# GRAPH_TENANT_ID=00000000-0000-0000-0000-000000000000
# GRAPH_CLIENT_ID=00000000-0000-0000-0000-000000000000
# GRAPH_CLIENT_SECRET=dein-client-secret

# Optional fester Session-Schlüssel (sonst wird data/secret.key erzeugt):
# BSP_SECRET_KEY=
